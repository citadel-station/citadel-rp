/datum/lore/character_background/citizenship/species/scori/empire
	name = "Itema-Arishrim"
	id = "citizenship_scori_empire"
	category = "Surt"
	desc = "The imperial core to which all scorians in the local region of Surt have found themselves subject to, \
    their territory covering much of the planet's largest continent. Closer to the capital the technological level \
	rapidly increases, equalling something about on par with human civilization on terra in the 17th century. This, \
	along with a large standing army and ability to mobilize many more troops from their and their subject's ranks, \
	has made the prospect of outright annexation problematic enough for Nanotrasen and other interstellar entities \
	not to bother. Imperial culture otherwise remains a relative mystery as they prefer to leave dealing with outsiders to \
	their subjects, save for an observed emphasis on colonialism. A large focus is placed on making subjects of and absorbing \
	any smaller scorian tribes or nations they run into under their banner, including some attempts at exploration beyond \
	their continent's shores."
